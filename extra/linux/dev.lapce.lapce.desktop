[Desktop Entry]
Version=1.0
Type=Application

Name=MOONWITNESS IDE
Comment=The Engineering Observatory for evidence-driven software development
Categories=Development;IDE;
GenericName=Engineering IDE
StartupWMClass=lapce

Icon=moonwitness-ide
Exec=lapce %F
Terminal=false
MimeType=text/plain;inode/directory;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=lapce --new %F
Icon=moonwitness-ide
